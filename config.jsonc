[
    {
        "layer": "top",
        "position": "top",
        "height": 30,
        "include": [
            "./modules/clock.jsonc",
            "./modules/audio.jsonc"
        ],
        "modules-center": [
            "clock"
        ],
        "modules-right": [
            "pulseaudio"
        ]
    },
    {
        "name": "overlay",
        "layer": "bottom",
        "position": "top",
        "height": 30,
        "margin-top": -30,
        "exclusive": false,
        "passthrough": true,
        "include": [
            "./modules/clock.jsonc"
        ],
        "modules-center": [
            "custom/cava"
        ]
    }
]